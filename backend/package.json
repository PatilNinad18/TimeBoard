{
  "name": "timeboard",
  "version": "1.0.0",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.timeboard.app",
    "productName": "TimeBoard",
    "artifactName": "TimeBoard-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "../frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend-dist"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/logo.ico"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "AI-powered productivity and activity tracking desktop application",
  "dependencies": {
    "active-win": "^8.2.1",
    "better-sqlite3": "^12.4.1",
    "desktop-idle": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9"
  }
}
